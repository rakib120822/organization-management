model ATTACHMENT {
    id        String   @id @default(uuid())
    taskId    String?
    fileName  String
    fileType  String
    fileSize  Int
    fileUrl   String
    commentId String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    task TASK? @relation(fields: [taskId], references: [id])
    comment COMMENT? @relation(fields: [commentId], references: [id])
}
