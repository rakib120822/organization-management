```ejs
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Password Changed Successfully</title>
</head>

<body
  style="
    margin: 0;
    padding: 0;
    background-color: #f4f4f5;
    font-family: Arial, Helvetica, sans-serif;
  "
>
  <table
    width="100%"
    cellpadding="0"
    cellspacing="0"
    border="0"
    style="
      background-color: #f4f4f5;
      padding: 40px 20px;
    "
  >
    <tr>
      <td align="center">

        <!-- Main Container -->
        <table
          width="100%"
          cellpadding="0"
          cellspacing="0"
          border="0"
          style="
            max-width: 500px;
            background-color: #ffffff;
            border-radius: 12px;
            overflow: hidden;
          "
        >

          <!-- Header -->
          <tr>
            <td
              style="
                padding: 30px;
                text-align: center;
                background-color: #18181b;
              "
            >
              <h1
                style="
                  margin: 0;
                  color: #ffffff;
                  font-size: 24px;
                "
              >
                Password Changed
              </h1>
            </td>
          </tr>

          <!-- Content -->
          <tr>
            <td style="padding: 35px 30px;">

              <h2
                style="
                  margin: 0 0 15px;
                  color: #18181b;
                  font-size: 20px;
                "
              >
                Hello <%= name %>,
              </h2>

              <p
                style="
                  margin: 0 0 20px;
                  color: #52525b;
                  font-size: 15px;
                  line-height: 1.6;
                "
              >
                Your account password has been changed successfully.
              </p>

              <!-- Success Message -->
              <div
                style="
                  margin: 25px 0;
                  padding: 20px;
                  background-color: #f0fdf4;
                  border: 1px solid #bbf7d0;
                  border-radius: 8px;
                  text-align: center;
                "
              >
                <div
                  style="
                    margin-bottom: 10px;
                    font-size: 32px;
                  "
                >
                  ✓
                </div>

                <p
                  style="
                    margin: 0;
                    color: #166534;
                    font-size: 16px;
                    font-weight: bold;
                  "
                >
                  Password changed successfully
                </p>
              </div>

              <p
                style="
                  margin: 0 0 15px;
                  color: #52525b;
                  font-size: 14px;
                  line-height: 1.6;
                "
              >
                You can now use your new password to sign in to your account.
              </p>

              <p
                style="
                  margin: 0;
                  color: #71717a;
                  font-size: 13px;
                  line-height: 1.6;
                "
              >
                If you did not make this change, please secure your account
                immediately by contacting our support team.
              </p>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td
              style="
                padding: 20px 30px;
                background-color: #fafafa;
                text-align: center;
                border-top: 1px solid #e4e4e7;
              "
            >
              <p
                style="
                  margin: 0;
                  color: #a1a1aa;
                  font-size: 12px;
                "
              >
                This is an automated email. Please do not reply.
              </p>
            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>
</body>
</html>
