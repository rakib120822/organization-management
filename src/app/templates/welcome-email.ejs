<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Welcome</title>
  </head>

  <body style="margin:0; padding:0; background:#f4f4f5; font-family:Arial, Helvetica, sans-serif;">
    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="padding:40px 20px; background:#f4f4f5;">
      <tr>
        <td align="center">
          <table width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:500px; background:#ffffff; border-radius:12px; overflow:hidden;">
            <tr>
              <td align="center" style="padding:30px; background:#18181b;">
                <h1 style="margin:0; color:#ffffff; font-size:24px;">Welcome!</h1>
              </td>
            </tr>

            <tr>
              <td style="padding:35px 30px;">
                <h2 style="margin:0 0 15px; color:#18181b; font-size:20px;">
                  Hi <%= name %> 👋
                </h2>

                <p style="margin:0 0 20px; color:#52525b; font-size:15px; line-height:1.6;">
                  Your account has been created successfully. We're happy to have you with us!
                </p>

                <p style="margin:0; color:#52525b; font-size:15px; line-height:1.6;">
                  You can now log in and start using your account.
                </p>
              </td>
            </tr>

            <tr>
              <td align="center" style="padding:20px 30px; background:#fafafa; border-top:1px solid #e4e4e7;">
                <p style="margin:0; color:#a1a1aa; font-size:12px;">
                  This is an automated email. Please do not reply.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>